{
	"author": "Paul Williams",
	"name": "@paulio/auto-import-svelte",
	"description": "P72: Auto import Svelte components",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"license": "MIT",
	"version": "0.1.2",
	"keywords": [
		"svelte",
		"auto"
	],
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PaulioRandall/p72-auto-import-svelte.git"
	},
	"scripts": {
